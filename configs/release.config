CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 状态 / 服务类 LuCI 应用：WiFi 历史、网络看门狗、组播与 RTP 中继、
# WiFi 定时开关、网络唤醒。全部来自 luci 与 packages feed，本地零代码。
#
# 每个应用的 daemon 必须与它同时打开：OpenWrt 把包依赖表达成 Kconfig 的
# "depends on"，make defconfig 不会替你补依赖 —— 只开 luci-app-* 会在依赖
# 检查处直接失败（"xxx is not set but is required by ..."）。
CONFIG_PACKAGE_luci-app-wifihistory=y
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_luci-app-msd_lite=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_watchcat=y
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_wifischedule=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-i18n-wifihistory-zh-cn=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y
CONFIG_PACKAGE_luci-i18n-msd_lite-zh-cn=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wifischedule-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# Lucky（DDNS / 反向代理 / 端口转发）。核心是上游预编译的 arm64 二进制，
# 版本 2.27.2，构建时按固定哈希校验（见 package/lucky/lucky/Makefile）。
# 它占约 9 MB（二进制 8.9 MB），本项目所有机型都是 256 MB NAND，放得下；
# 以后若新增小 flash 机型，这里要重新评估。
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y

# 需求二：PON 配置界面换成 luci-app-onu（ONU 顶级菜单，七页：状态/硬件身份/
# 认证/上网/IPTV/语音/诊断）。上游 pbs05 的 luci-app-pon + luci-app-iptv 已被
# naoki66/OpenWrt_ONU_CONFIG 合并重写，包名不复存在，所以这里是替代而非新增。
# 语音页在这一轮只有界面与 VLAN 投递：SIP/H.248 协议栈与 FXS（Si32192）的
# DTS/驱动等硬件侧到位后再接。
CONFIG_PACKAGE_luci-app-onu=y
CONFIG_PACKAGE_luci-i18n-onu-zh-cn=y
