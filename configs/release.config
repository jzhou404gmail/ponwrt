CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# 广告过滤：adblock-fast（DNS 层）+ LuCI。默认值（anti-AD/OISD Small、
# 小米电视广告域名、force_dns=0）由 adblock-fast-ponwrt 包写入；
# PassWall 兼容性靠 feed-patches/packages/net/adblock-fast/0001-hup-passwall-dnsmasq.patch。
# 注意：不能把 force_dns 留在默认的 1，否则它会在 fw4 里把客户端 53
# 抢到主 dnsmasq，绕过 PassWall 的 chinadns-ng。
CONFIG_PACKAGE_adblock-fast=y
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-i18n-adblock-fast-zh-cn=y
CONFIG_PACKAGE_adblock-fast-ponwrt=y

# adblock-fast 推荐的 GNU 文本工具：列表合并约 44s -> 17s，约 1.5 MB。
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_grep=y
CONFIG_PACKAGE_sed=y
CONFIG_PACKAGE_coreutils-sort=y
