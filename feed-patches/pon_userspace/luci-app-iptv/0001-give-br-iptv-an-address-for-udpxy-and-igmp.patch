@@ -35,6 +35,23 @@ validate_vlan() {
 	[ "$vid" -ge 1 ] && [ "$vid" -le 4094 ]
 }
 
+validate_ipv4() {
+	local ip="$1"
+	local octet
+	local IFS=.
+
+	set -- $ip
+	[ $# -eq 4 ] || return 1
+
+	for octet in "$@"; do
+		case "$octet" in
+			''|*[!0-9]*) return 1 ;;
+		esac
+		[ "${#octet}" -le 3 ] || return 1
+		[ "$octet" -le 255 ] || return 1
+	done
+}
