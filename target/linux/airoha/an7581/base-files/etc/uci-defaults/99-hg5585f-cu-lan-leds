#!/bin/sh
#
# Bind the four panel LAN LEDs on the FiberHome HG5585F-CU.
#
# board.d/01_leds only writes /etc/board.json, and /bin/config_generate only
# turns that into /etc/config/system while the system config is still absent.
# An upgrade that keeps settings therefore carries its old system config over
# and never receives the four config led sections the CU case describes. Two
# kinds of install end up with unbound panel LEDs because of it:
#
#   * an install older than the CU LED work has no config led section for
#     lan1..lan4 at all. leds-gpio still registers blue:lan-1..4, but nothing
#     selects the netdev trigger, so all four panel LEDs stay dark while the
#     ports themselves link fine - the jacks look dead, the jacks are fine.
#   * an install from the fork's withdrawn PHY LED0 route still carries
#     mt7530-0:09/0a/0b/0c:green:lan-1..4. Those class devices are gone, so
#     those sections are inert and keep the right trigger from being bound.
#
# The class devices are not the problem: /etc/board.json is regenerated on every
# upgrade and already carries the correct blue:lan-* entries. Only the UCI side
# goes stale, which is what this script repairs. On a fresh install, where
# config_generate writes both files together, every check below is already
# satisfied and nothing happens.
#
# Idempotent, and deliberately narrow: a section is only dropped when it names
# one of the four withdrawn CU PHY LED0 devices, and a binding is only added
# when the class device exists and no section targets it yet.

. /lib/functions.sh

[ "$(board_name)" = "fiberhome,hg5585f-cu" ] || exit 0

_led_sections() {
	uci -q show system | sed -n 's/^system\.\([^=]*\)=led$/\1/p'
}

_led_bound_to() {
	local want="$1" s

	for s in $(_led_sections); do
		[ "$(uci -q get "system.$s.sysfs")" = "$want" ] && return 0
	done

	return 1
}

changed=

# Drop the inert PHY LED0 sections. Anything else the user configured is left
# alone even when its class device is missing - an absent device is not proof
# that the section is unwanted, but these four names are.
for s in $(_led_sections); do
	case "$(uci -q get "system.$s.sysfs")" in
	mt7530-0:0[9abc]:green:lan-[1-4])
		uci -q delete "system.$s"
		changed=1
		;;
	esac
done

# Bind whatever panel LED is still unbound.
for n in 1 2 3 4; do
	class="blue:lan-$n"

	[ -e "/sys/class/leds/$class" ] || continue
	_led_bound_to "$class" && continue

	section="led_lan$n"
	# Never take over a section that already uses the canonical name.
	if [ -n "$(uci -q get "system.$section")" ]; then
		section="${section}_cu"
		[ -n "$(uci -q get "system.$section")" ] && continue
	fi

	uci -q set "system.$section=led"
	uci -q set "system.$section.name=lan$n"
	uci -q set "system.$section.sysfs=$class"
	uci -q set "system.$section.trigger=netdev"
	uci -q set "system.$section.mode=link tx rx"
	uci -q set "system.$section.dev=lan$n"
	changed=1
done

if [ -n "$changed" ]; then
	uci -q commit system
	logger -t hg5585f-cu-leds "bound the four panel LAN LED netdev triggers"
fi

exit 0
