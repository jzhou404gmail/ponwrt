. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
airoha,an7581-evb)
	ucidef_set_led_usbport "usb1" "USB 1" "green:usb-1" "usb1-port1" "usb2-port1"
	ucidef_set_led_usbport "usb2" "USB 2" "green:usb-2" "usb3-port1" "usb4-port1"
	;;
gemtek,w1700k-ubi)
	ucidef_set_led_netdev "lan3-yellow" "lan3" "yellow:lan-3" "lan3" "link_10 link_100"
	ucidef_set_led_netdev "lan3-green" "lan3" "green:lan-3" "lan3" "link_1000 tx rx"
	ucidef_set_led_netdev "lan4-yellow" "lan4" "yellow:lan-4" "lan4" "link_10 link_100"
	ucidef_set_led_netdev "lan4-green" "lan4" "green:lan-4" "lan4" "link_1000 tx rx"
	;;
gemtek,xg2010g)
	# GPIO42 and GPIO46 drive the LAN4 bicolor LED selected by link speed.
	ucidef_set_led_netdev "lan4-yellow" "lan4" "yellow:lan-4" "lan4" "link_10 link_100"
	ucidef_set_led_netdev "lan4-green" "lan4" "green:lan-4" "lan4" "link_1000 tx rx"
	;;
nokia,xg-040g-md-ubi|\
nokia,xg-040g-tf-ubi)
	# Panel LAN1 is the EN8811H 2.5G PHY at MDIO address 0x0f. The PHY driver
	# programs the LED into user-defined (external control) mode in
	# air_leds_init(), so the jack stays dark until a trigger is bound - the
	# "default-state = keep" in the DTS does NOT give hardware link indication.
	ucidef_set_led_netdev "lan1" "lan1" "mt7530-0:0f:green:lan-1" "lan1" "link tx rx"
	# Panel LAN2/LAN3/LAN4 are switch ports 2/3/4, i.e. PHY 0x0a/0x0b/0x0c,
	# so here the panel order matches the switch order.
	ucidef_set_led_netdev "lan2" "lan2" "mt7530-0:0a:green:lan-2" "lan2" "link tx rx"
	ucidef_set_led_netdev "lan3" "lan3" "mt7530-0:0b:green:lan-3" "lan3" "link tx rx"
	ucidef_set_led_netdev "lan4" "lan4" "mt7530-0:0c:green:lan-4" "lan4" "link tx rx"
	;;
unionman,ung00a)
	# The UNG00A panel order is the reverse of the switch port order: panel
	# LAN2/LAN3/LAN4 are switch ports 3/2/1, i.e. PHY 0x0b/0x0a/0x09 (see the
	# mapping comment in an7581-unionman-ung00a.dts). A PHY LED class device is
	# named "<mdio-bus-id>:<phy-addr>:<color>:<function>-<enumerator>", so each
	# line must name the PHY that belongs to its own jack - walking the PHYs in
	# ascending address order binds every trigger to the wrong port and leaves
	# the LAN4 jack with no LED device at all (PHY 0x0c is not wired here).
	ucidef_set_led_netdev "lan1" "lan1" "mt7530-0:0f:green:lan-1" "lan1" "link tx rx"
	ucidef_set_led_netdev "lan2" "lan2" "mt7530-0:0b:green:lan-2" "lan2" "link tx rx"
	ucidef_set_led_netdev "lan3" "lan3" "mt7530-0:0a:green:lan-3" "lan3" "link tx rx"
	ucidef_set_led_netdev "lan4" "lan4" "mt7530-0:09:green:lan-4" "lan4" "link tx rx"
	;;
znxt,zn504xg-d|\
znxt,zn515xg-d)
	# Same layout as the Nokia boards: panel LAN1 is the EN8811H 2.5G PHY at
	# MDIO 0x0f (GDM4), LAN2/LAN3/LAN4 are switch ports 2/3/4, i.e. PHY
	# 0x0a/0x0b/0x0c. Without the LAN1 line the 2.5G jack has no LED trigger at
	# all and looks dead even when the link is up.
	ucidef_set_led_netdev "lan1" "lan1" "mt7530-0:0f:green:lan-1" "lan1" "link tx rx"
	ucidef_set_led_netdev "lan2" "lan2" "mt7530-0:0a:green:lan-2" "lan2" "link tx rx"
	ucidef_set_led_netdev "lan3" "lan3" "mt7530-0:0b:green:lan-3" "lan3" "link tx rx"
	ucidef_set_led_netdev "lan4" "lan4" "mt7530-0:0c:green:lan-4" "lan4" "link tx rx"
	;;
quantum,q1000k-ubi)
	ucidef_set_led_netdev "lan1-yellow" "lan1" "yellow:lan" "lan1" "link_10 link_100"
	ucidef_set_led_netdev "lan1-green" "lan1" "green:lan" "lan1" "link_1000 tx rx"
	;;
esac

board_config_flush

exit 0
