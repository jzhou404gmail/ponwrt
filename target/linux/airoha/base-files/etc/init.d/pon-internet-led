#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# 面板「上网」灯 = 真实上网状态。
#
# 常驻探测循环交给 procd 守护（判断逻辑在 /usr/libexec/pon-internet-led）：
# 周期性请求几个 well-known 站点，能通就点亮绿灯，连续失败就熄灭。
# START=96：等网络（network/firewall/PON 代理）都起来之后再开始探。
#
# 关闭：/etc/init.d/pon-internet-led stop && /etc/init.d/pon-internet-led disable
#       stop 会把灯还给内核触发器（DTS 里的 pon0-online）。
# 也可以只改 /etc/config/pon-led 里的 option enabled '0'（下次开机不启动）。

START=96
STOP=09
USE_PROCD=1

start_service() {
	local enabled

	enabled=$(uci -q get pon-led.internet.enabled 2>/dev/null)
	case "$enabled" in
	0|off|no|false|disabled)
		echo "pon-led.internet.enabled=$enabled，跳过启动（灯归内核触发器）"
		/usr/libexec/pon-internet-led release
		return 0
		;;
	esac

	procd_open_instance
	procd_set_param command /usr/libexec/pon-internet-led watch
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 别留一盏没人管的灯：还给内核触发器
	[ -x /usr/libexec/pon-internet-led ] && /usr/libexec/pon-internet-led release
}
