#!/bin/sh

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

# UBI rounds the declared image size up to full logical eraseblocks.
pon_data_target()
{
	json_add_object "$1"
	json_add_string type "$2"
	json_add_int size "$3"
	[ "$2" = ubi ] && json_add_string parent ubi
	json_close_object
}

identity_field()
{
	json_add_object "$1"
	json_add_string kind "$2"
	json_add_int offset "$3"
	json_add_int size "$4"
	json_add_string encoding "$5"
	[ -n "$6" ] && json_add_int vssn_offset "$6"
	json_close_object
}

board_config_update
json_add_object pon_data

board="$(board_name)"
case "$board" in
fiberhome,hg5382a|fiberhome,hg5585f-ct|fiberhome,hg5585f-cu)
	pon_data_target factory ubi 1048576
	;;
znxt,zn504xg-d|znxt,zn515xg-d|unionman,ung00a)
	pon_data_target factory ubi 2359296
	;;
# The factory UBI volume on this board is 1 MiB, so it carries the compact
# H3C layout instead of the vendor's 0x240000 reservearea offsets.
h3c,hm2004-du)
	pon_data_target factory ubi 1048576
	;;
gemtek,xg2010g)
	pon_data_target factory ubi 2097152
	;;
nokia,xg-040g-md-ubi|nokia,xg-040g-tf-ubi|nokia,xg-040g-mf-ubi)
	pon_data_target bosa ubi 262144
	pon_data_target ri ubi 262144
	;;
nokia,xg-040g-mf)
	pon_data_target bosa mtd 262144
	pon_data_target ri mtd 262144
	;;
esac

json_close_object

case "$board" in
gemtek,xg2010g)
	identity_available=1
	json_add_object identity
	json_add_object targets
	json_add_object factory
	json_add_object fields
	identity_field pon_sn pon-sn 210 12 pon-ascii12
	identity_field pon_mac mac 108 17 mac-colon17
	identity_field lan_base_mac mac 134 17 mac-colon17
	json_close_object
	json_close_object
	json_close_object
	json_close_object
	;;
nokia,xg-040g-md-ubi|nokia,xg-040g-tf-ubi|nokia,xg-040g-mf-ubi|nokia,xg-040g-mf)
	identity_available=1
	json_add_object identity
	json_add_object targets
	json_add_object ri
	# RI couples the display SN to a raw VSSN copy and two record checksums.
	json_add_string codec nokia-ri-v1
	json_add_object fields
	identity_field pon_sn pon-sn 26 12 pon-ascii12 88
	identity_field board_mac mac 62 6 mac-binary6
	json_close_object
	json_close_object
	json_close_object
	json_close_object
	;;
h3c,hm2004-du)
	identity_available=1
	json_add_object identity
	json_add_object targets
	json_add_object factory
	json_add_object fields
	# Device SN, plain ASCII (H3CT0005EBF0) at 0x60 of the compact layout.
	identity_field pon_sn pon-sn 96 12 pon-ascii12
	json_close_object
	json_close_object
	json_close_object
	json_close_object
	;;
fiberhome,hg5382a|fiberhome,hg5585f-ct|fiberhome,hg5585f-cu)
	# 偏移与编码取自 an7581-fiberhome-ubi-parts.dtsi 的 &ubi_factory fixed-layout，
	# 也就是内核给这些 netdev 读 MAC / 给 airoha-xpon 读 ONU SN 的同一份数据：
	#   0x2000  6 字节 MAC（mac-base，GDM1/GDM2 的 netdev 就是从这里取的）
	#   0x2010  8 字节 ONU SN（4 字节厂商标识 + 4 字节序列，即 GPON 的 8 字节形式）
	#   0x2020 32 字节产品序列号（定长、NUL 结尾的 ASCII）
	# 只声明真实存在的三块；不猜其它字段。
	identity_available=1
	json_add_object identity
	json_add_object targets
	json_add_object factory
	json_add_object fields
	identity_field pon_mac mac 8192 6 mac-binary6
	identity_field pon_sn pon-sn 8208 8 pon-binary8
	identity_field device_sn serial 8224 32 serial-text
	json_close_object
	json_close_object
	json_close_object
	json_close_object
	;;
esac

board_config_flush
if [ "$identity_available" = 1 ]; then
	touch /tmp/pon-board-identity.available
fi
