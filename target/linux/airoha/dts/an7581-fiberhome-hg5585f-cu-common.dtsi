/dts-v1/;

#include "an7581-fiberhome-hg5585f-common.dtsi"

/*
 * The CU variant maps its four panel ports to internal PHY1 through PHY4.
 *
 * Each panel LAN LED hangs off the PHY LED0 output of its own port. Parallel
 * NAND claims GPIO4-7 and GPIO30-42, so the only pins this board still exposes
 * for PHY LED0 are GPIO43-46, which the AN7581 pinctrl covers through its
 * "phyN_led0" groups. Selecting the "gbe-led" pinctrl in an7581_phy_probe() is
 * what actually enables the PHY LED output: without it all four LAN LEDs stay
 * dark even though the ports link fine.
 */
&en7581_pinctrl {
	gswp1_led0_pins: gswp1-led0-pins {
		mux {
			function = "phy1_led0";
			pins = "gpio43";
		};
	};

	gswp2_led0_pins: gswp2-led0-pins {
		mux {
			function = "phy2_led0";
			pins = "gpio44";
		};
	};

	gswp3_led0_pins: gswp3-led0-pins {
		mux {
			function = "phy3_led0";
			pins = "gpio45";
		};
	};

	gswp4_led0_pins: gswp4-led0-pins {
		mux {
			function = "phy4_led0";
			pins = "gpio46";
		};
	};
};

&gsw_port1 {
	label = "lan1";
	status = "okay";
};

&gsw_phy1 {
	status = "okay";
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp1_led0_pins>;
};

&gsw_phy1_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <1>;
	active-low;
	status = "okay";
};

&gsw_phy2 {
	status = "okay";
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp2_led0_pins>;
};

&gsw_phy2_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <2>;
	active-low;
	status = "okay";
};

&gsw_phy3 {
	status = "okay";
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp3_led0_pins>;
};

&gsw_phy3_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <3>;
	active-low;
	status = "okay";
};

&gsw_phy4 {
	status = "okay";
	pinctrl-names = "gbe-led";
	pinctrl-0 = <&gswp4_led0_pins>;
};

&gsw_phy4_led0 {
	color = <LED_COLOR_ID_GREEN>;
	function = LED_FUNCTION_LAN;
	function-enumerator = <4>;
	active-low;
	status = "okay";
};
