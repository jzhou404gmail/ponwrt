# 本机构建配置备份与版本覆盖文件：./build.sh --config=<档> 会生成 .config.<档>，
# 被覆盖/还原时另有 .config.bak-* / .clobbered-* / .RESTORED-* / .old*。
# 一律不入库：它们只是本机某一台机器的选择，跟 configs/ 里的种子配置不是一回事。
/.config.*
/version

# 原厂固件转储与个人设备备份：体积大（数 GB）且含设备身份数据，绝不入库
/原厂备份/

# 与固件无关的本机运维脚本
/clone-sda/
/shutdown-analyze.sh

# 厂商资料与 SDK 的大体积拷贝（Airoha_Doc / airoha_sdk，约 160 MB）：
# 只作本地参考，构建不使用，不入库
/Airoha/

# python 缓存（体检脚本被 import 时会生成）
__pycache__/

# ---------------------------------------------------------------------------
# “自有”内容：只留本机，绝不入库、绝不推送。规则见 AGENTS.md；
# 提交/推送前由 scripts/check-local-only.sh 与 .githooks/ 兜底。
# ---------------------------------------------------------------------------

# 本地笔记/排障记录：设备身份、内网信息、凭据等
/docs/

# 新增自有脚本/配置/资料的首选目录（整目录忽略）
/local/
/notes/
/secrets/

# 本机构建产物与发布包：体积大，且可能带本机 overlay/默认值
/release/
*.itb
*.tar.zst

# 自有域名/IP 与 Cloudflare 操作脚本：不随仓库分发
/scripts/cf-set-aaaa.sh
